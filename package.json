{
  "name": "liquidkit",
  "version": "0.1.0",
  "description": "Liquid Glass UI component library for React — true refraction, chromatic dispersion, light & dark.",
  "type": "module",
  "license": "MIT",
  "author": "Hamidreza Zargham",
  "homepage": "https://github.com/hamidrezazargham/liquidkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamidrezazargham/liquidkit.git"
  },
  "bugs": {
    "url": "https://github.com/hamidrezazargham/liquidkit/issues"
  },
  "keywords": [
    "react",
    "ui",
    "liquid-glass",
    "glassmorphism",
    "glass",
    "components",
    "design-system",
    "refraction"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/liquidkit.cjs",
  "module": "./dist/liquidkit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/liquidkit.js",
      "require": "./dist/liquidkit.cjs"
    },
    "./styles.css": "./dist/liquidkit.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode lib",
    "build:docs": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  }
}
