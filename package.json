{
  "name": "@hamidrezazargham/liquidkit",
  "version": "0.4.0",
  "description": "Liquid Glass UI component library for React — one frosted glass surface, light & dark.",
  "type": "module",
  "license": "MIT",
  "author": "Hamidreza Zargham",
  "homepage": "https://hamidrezazargham.github.io/liquidkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamidrezazargham/liquidkit.git"
  },
  "bugs": {
    "url": "https://github.com/hamidrezazargham/liquidkit/issues"
  },
  "keywords": [
    "react",
    "ui",
    "liquid-glass",
    "glassmorphism",
    "glass",
    "components",
    "design-system",
    "frosted-glass"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/liquidkit.cjs",
  "module": "./dist/liquidkit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/liquidkit.js",
      "require": "./dist/liquidkit.cjs"
    },
    "./styles.css": "./dist/liquidkit.css",
    "./themes.css": "./dist/themes.css",
    "./palettes.css": "./dist/palettes.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode lib && node scripts/copy-themes.mjs",
    "build:docs": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  }
}
